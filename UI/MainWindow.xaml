<Window x:Class="LoadReport.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:LoadReport"
    mc:Ignorable="d"
    WindowStyle="None"
    Title="Load Report Generator"
    Height="550"
    Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>

        <Image Grid.RowSpan="3"
               Source="Images/Refinery.png"
               Stretch="UniformToFill" />

        <!-- Header -->
        <Grid Grid.Row="0">
            <Border Background="#1B1B1B">
                <TextBlock Text="Load Report Generator"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="10"
                           VerticalAlignment="Center" />
                
               
            </Border>

            <Button Content="X"
        Foreground="WhiteSmoke"
        Background="Transparent"
        BorderBrush="Transparent"
        FontWeight="Bold"
        Width="30"
        Height="30"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Margin="0,0,10,0"
        Click="Exit_Click">

                <Button.Style>
                    <Style TargetType="Button">

                        <Setter Property="FontSize" Value="16"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="FontSize" Value="20"/>
                            </Trigger>
                        </Style.Triggers>

                    </Style>
                </Button.Style>

            </Button>

        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Hand side -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Left Hand Top Section -->
                <Grid Grid.Row="0">
                    <Border Background="#DD1E1E1E"
                            CornerRadius="12"
                            Margin="10"
                            Padding="15">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Project Information"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="10,0,10,0" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="JobDescriptionTextBlock"
                                           Text="Job Description:"
                                           Foreground="White"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                <TextBox x:Name="JobDescriptionTextBox" Margin="10,5,0,5" Width="210" />
                            </StackPanel>
                            <!-- Job Number -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="JobNumberTextBlock"
                                           Text="Job Number:"
                                           Foreground="White"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                <TextBox x:Name="JobNumberTextBox" Margin="10,5,0,5" Width="210" />
                            </StackPanel>
                            <!-- Client Name -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ClientNameTextBlock"
                                           Text="Client Name:"
                                           Foreground="White"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                <TextBox x:Name="ClientNameTextBox" Margin="10,5,0,5" Width="210" />
                            </StackPanel>
                            <!-- Client Address -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ClientAddressTextBlock"
                                           Text="Client Address:"
                                           Foreground="White"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                <TextBox x:Name="ClientAddressTextBox" Margin="10,5,0,5" Width="210" />
                            </StackPanel>
                            <!-- Company Logo -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="AddCompanyLogoTextBlock"
                                           Text="Company Logo:"
                                           Foreground="White"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                <Button Content=" Add Logo "
                                        Margin="10,5,0,5"
                                        Click="AddCompanyLogoClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Left Hand Bottom Section -->
                <Grid Grid.Row="1">
                    <Border Background="#DD1E1E1E"
                            CornerRadius="12"
                            Margin="10"
                            Padding="15">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Vessel Information"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="10,0,10,0" />

                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="VesselIDTextBlock"
                                           Text="Vessel ID:"
                                           Foreground="White"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                <TextBox x:Name="VesselIDTextBox"
                                         Margin="10,5,0,5"
                                         Width="210" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="VesselTypeTextBlock"
                                           Text="Vessel Template:"
                                           Foreground="White"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                <ComboBox x:Name="VesselTypeComboBox"
                                          Margin="10,5,0,5"
                                          Width="210" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="BedNumberTextBlock"
                                           Text="Bed Number:"
                                           Foreground="White"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                <ComboBox x:Name="BedNumberComboBox"
                                          Margin="10,5,0,5"
                                          Width="210">
                                    <ComboBoxItem Content="1" />
                                    <ComboBoxItem Content="2" />
                                    <ComboBoxItem Content="3" />
                                    <ComboBoxItem Content="4" />
                                    <ComboBoxItem Content="5" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="InitialOutageTextBlock"
                                           Text="Initial Outage:"
                                           Foreground="White"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                <TextBox x:Name="InitialOutageTextBox"
                                         Margin="10,5,0,5"
                                         Width="210" />
                                <TextBlock Text="mm"
                                           Foreground="White"
                                           Margin="2,10,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="InternalDiameterTextBlock"
                                           Text="Internal Diameter:"
                                           Foreground="White"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                <TextBox x:Name="InternalDiameterTextBox"
                                         Margin="10,5,0,5"
                                         Width="210" />
                                <TextBlock Text="mm"
                                           Foreground="White"
                                           Margin="2,10,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Right Hand Side -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Right Hand Top Section -->
                <Grid Grid.Row="0">
                    <Border Background="#DD1E1E1E"
                            CornerRadius="12"
                            Margin="10"
                            Padding="15">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Media Layer"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="10,0,10,0" />

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Media Layer:"
                                           Foreground="White"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                <Button Content=" Add Layer "
                                        Margin="10,5,0,5"
                                        Click="LayerButton_Click" />
                                <Button x:Name="ButtonRemoveLayer"
                                        Content=" Remove Last "
                                        Margin="10,5,0,5"
                                        Click="RemoveLayer_Click" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Layers:"
                                           Foreground="White"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                <ListBox x:Name="LayerListBox"
                                         Background="#1B1B1B"
                                         Margin="10,5,0,5"
                                         Width="220"
                                         Height="280" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Right Hand Bottom Section -->
                <Grid Grid.Row="1">
                    <Border Background="#DD1E1E1E"
                            CornerRadius="12"
                            Margin="10"
                            Padding="15">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Report"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="10,0,10,0" />
                            <Button Content=" Generate "
                                    Margin="10,5,0,5"
                                    Click="Generate_Button_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2">
            <Border Background="#1B1B1B">
            </Border>
        </Grid>
    </Grid>
</Window>
