<Window x:Class="LoadReport.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:LoadReport"
    mc:Ignorable="d"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="Transparent"
    Title="Load Report Generator"
    Height="580"
    Width="810"
    FontFamily="Consolas">
    
    <!-- Window Resources -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Button.xaml"/>
                <ResourceDictionary Source="Styles/TextBox.xaml"/>
                <ResourceDictionary Source="Styles/ComboBox.xaml"/>
                <ResourceDictionary Source="Styles/TextBlock.xaml"/>
                <ResourceDictionary Source="Styles/Exit.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>


    <Border CornerRadius="12">
        <Border.Background>
            <ImageBrush ImageSource="Images/Refinery.png"
                        Stretch="UniformToFill"/>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>
            <!-- Header -->
            <Grid Grid.Row="0">
                <Border Background="#1B1B1B" MouseDown="Border_MouseDown" CornerRadius="12,12,0,0">
                    <TextBlock Text="Load Report Generator"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#E6E6E6"
                           Margin="10"
                           VerticalAlignment="Center" />
                </Border>

                <Button Content="X"
            Foreground="#E6E6E6"
            Background="Transparent"
            BorderBrush="Transparent"
            FontWeight="Bold"
            Width="30"
            Height="30"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="0,0,10,0"
            Click="Exit_Click"
            Style="{StaticResource Exit}">
                </Button>


            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Hand side -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Left Hand Top Section -->
                    <Grid Grid.Row="0">
                        <Border Background="#D9232323"
                            CornerRadius="12"
                            Margin="10"
                            Padding="15">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Project Information"
                                       Style="{StaticResource HeaderTextBlock}"
                                       Margin="10,0,10,0" />
                                <StackPanel Orientation="Horizontal">

                                    <TextBlock x:Name="JobDescriptionTextBlock"
                                           Text="Job Description:"                                       
                                           Margin="10,5,0,5"
                                           Width="100" 
                                           Style="{StaticResource BodyTextBlock}"/>

                                    <TextBox x:Name="JobDescriptionTextBox" 
                                         Margin="10,5,0,5" 
                                         Width="210"
                                         Style="{StaticResource BaseTextBoxStyle}" />

                                </StackPanel>
                                <!-- Job Number -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="JobNumberTextBlock"
                                           Text="Job Number:"
                                           Style="{StaticResource BodyTextBlock}"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                    <TextBox x:Name="JobNumberTextBox" 
                                         Margin="10,5,0,5" 
                                         Width="210" 
                                         Style="{StaticResource BaseTextBoxStyle}" />

                                </StackPanel>
                                <!-- Client Name -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ClientNameTextBlock"
                                           Text="Client Name:"
                                           Style="{StaticResource BodyTextBlock}"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                    <TextBox x:Name="ClientNameTextBox" 
                                         Margin="10,5,0,5" 
                                         Width="210" 
                                         Style="{StaticResource BaseTextBoxStyle}" />
                                </StackPanel>
                                <!-- Client Address -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ClientAddressTextBlock"
                                           Text="Client Address:"
                                            Style="{StaticResource BodyTextBlock}"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                    <TextBox x:Name="ClientAddressTextBox" 
                                         Margin="10,5,0,5" 
                                         Width="210" 
                                         Style="{StaticResource BaseTextBoxStyle}" />
                                </StackPanel>
                                <!-- Company Logo -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="AddCompanyLogoTextBlock"
                                           Text="Company Logo:"
                                           Style="{StaticResource BodyTextBlock}"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                    <Button Content="Add"
                                        Margin="10,5,0,5"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Click="AddCompanyLogoClick" />
                                    <ListBox x:Name="LogoListBox"
                                         Background="#2C2C2C"
                                         Foreground="#E6E6E6"
                                         Margin="10,5,0,5"
                                         Width="163"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Left Hand Bottom Section -->
                    <Grid Grid.Row="1">
                        <Border Background="#D9232323"
                            CornerRadius="12"
                            Margin="10"
                            Padding="15">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Vessel Information"
                                       Style="{StaticResource HeaderTextBlock}"
                                       Margin="10,0,10,0" />

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="VesselIDTextBlock"
                                           Text="Vessel ID:"
                                           Style="{StaticResource BodyTextBlock}"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                    <TextBox x:Name="VesselIDTextBox"
                                         Margin="10,5,0,5"
                                         Width="210"
                                         Style="{StaticResource BaseTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="VesselTypeTextBlock"
                                           Text="Vessel Template:"
                                           Style="{StaticResource BodyTextBlock}"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                    <ComboBox x:Name="VesselTypeComboBox"
                                          Margin="10,5,0,5"
                                          Width="150"
                                          Style="{StaticResource BaseComboBoxStyle}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="BedNumberTextBlock"
                                           Text="Bed Number"
                                           Style="{StaticResource BodyTextBlock}"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                    <ComboBox x:Name="BedNumberComboBox"
                                          Margin="10,5,0,5"
                                          Width="150"
                                          Style="{StaticResource BaseComboBoxStyle}">
                                        <ComboBoxItem Content="1" />
                                        <ComboBoxItem Content="2" />
                                        <ComboBoxItem Content="3" />
                                        <ComboBoxItem Content="4" />
                                        <ComboBoxItem Content="5" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="InitialOutageTextBlock"
                                           Text="Initial Outage:"
                                           Style="{StaticResource BodyTextBlock}"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                    <TextBox x:Name="InitialOutageTextBox"
                                         Margin="10,5,0,5"
                                         Width="210"
                                         Style="{StaticResource BaseTextBoxStyle}" />
                                    <TextBlock Text="mm"
                                           Style="{StaticResource BodyTextBlock}"
                                           Margin="2,10,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="InternalDiameterTextBlock"
                                           Text="Internal &#x0a;Diameter:"
                                           Style="{StaticResource BodyTextBlock}"
                                           Margin="10,5,0,5"
                                           Width="100" />
                                    <TextBox x:Name="InternalDiameterTextBox"
                                         Margin="10,5,0,5"
                                         Width="210"
                                         Style="{StaticResource BaseTextBoxStyle}" />
                                    <TextBlock Text="mm"
                                           Style="{StaticResource BodyTextBlock}"
                                           Margin="2,10,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Right Hand Side -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Right Hand Top Section -->
                    <Grid Grid.Row="0">
                        <Border Background="#D9232323"
                            CornerRadius="12"
                            Margin="10"
                            Padding="15">
                            <StackPanel Orientation="Vertical">

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Media Layers:"
                                           Style="{StaticResource HeaderTextBlock}"
                                           Margin="10,5,0,5"
                                            />
                                    <Button Content="Add Layer"
                                        Margin="10,5,0,5"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Click="LayerButton_Click" />
                                    <Button x:Name="ButtonRemoveLayer"
                                        Content="Remove Last"
                                        Margin="10,5,0,5"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Click="RemoveLayer_Click" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">

                                    <ListBox x:Name="LayerListBox"
                                         Background="#2C2C2C"
                                         Margin="10,5,0,5"
                                         Width="330"
                                         Height="280"  
                                         Foreground="#E6E6E6"                                         
                                         FontSize="12"  />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Right Hand Bottom Section -->
                    <Grid Grid.Row="1">
                        <Border Background="#D9232323"
                            CornerRadius="12"
                            Margin="10"
                            Padding="15">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Report"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#E6E6E6"
                                       Margin="10,0,10,0" />
                                <Button Content="Generate"
                                    Margin="10,5,0,5"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Click="Generate_Button_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2">

                <Border Background="#1B1B1B"
            CornerRadius="0,0,12,12">

                    <Grid>
                        <TextBlock Text="Professional Reports Made Easy"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   FontStyle="Italic"
                                   Foreground="#A8A8A8"
                                   Margin="10,0,10,0" />

                        <TextBlock Text="Developed by Connor Macdonald"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   FontStyle="Italic"
                                   Foreground="#A8A8A8"
                                   Margin="10,0,10,0" />    
                    </Grid>

                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>
