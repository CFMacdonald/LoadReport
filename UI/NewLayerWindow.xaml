<Window x:Class="LoadReport.NewLayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoadReport"
        mc:Ignorable="d"
        Title="Add New Layer" Height="350" Width="450">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Section title -->
            <RowDefinition Height="8"/>    <!-- Spacer -->
            <RowDefinition Height="Auto"/> <!-- Form -->
            <RowDefinition Height="*"/>    <!-- Filler -->
            <RowDefinition Height="Auto"/> <!-- Footer / Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Add Layer"
                   FontSize="24"
                   FontWeight="Bold"
                   Grid.Row="0"/>

        <!-- Section title -->
        <TextBlock Text="Layer Information"
                   FontSize="14"
                   FontWeight="Bold"
                   Margin="0,8,0,0"
                   Grid.Row="1"/>

        <!-- Form -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Layer Type -->
                <RowDefinition Height="Auto"/> <!-- Product Name -->
                <RowDefinition Height="Auto"/> <!-- Actual Outage -->
                <RowDefinition Height="Auto"/> <!-- Target Outage -->
                <RowDefinition Height="Auto"/> <!-- Drum Quantity -->
                <RowDefinition Height="Auto"/> <!-- Drum Net Weight -->
                <RowDefinition Height="Auto"/> <!-- Load Method -->
            </Grid.RowDefinitions>

            <!-- Layer Type -->
            <TextBlock x:Name="LayerTypeTextBlock" Grid.Row="0" Grid.Column="0"
                       Text="Layer Type:"
                       VerticalAlignment="Center"
                       Margin="0,5,8,5"/>
            <ComboBox x:Name="LayerTypeComboBox"
                      Grid.Row="0" Grid.Column="1"
                      Margin="0,5,0,5"/>

            <!-- Product Name -->
            <TextBlock x:Name="ProductNameTextBlock" Grid.Row="1" Grid.Column="0"
                       Text="Product Name:"
                       VerticalAlignment="Center"
                       Margin="0,5,8,5"/>
            <TextBox x:Name="ProductNameTextBox"
                     Grid.Row="1" Grid.Column="1"
                     Margin="0,5,0,5"/>

            <!-- Actual Outage -->
            <TextBlock x:Name="ActualOutageTextBlock" Grid.Row="2" Grid.Column="0"
                       Text="Actual Outage:"
                       VerticalAlignment="Center"
                       Margin="0,5,8,5"/>
            <TextBox x:Name="ActualOutageTextBox"
                     Grid.Row="2" Grid.Column="1"
                     Margin="0,5,0,5"/>

            <!-- Target Outage -->
            <TextBlock x:Name="TargetOutageTextBlock" Grid.Row="3" Grid.Column="0"
                       Text="Target Outage:"
                       VerticalAlignment="Center"
                       Margin="0,5,8,5"/>
            <TextBox x:Name="TargetOutageTextBox"
                     Grid.Row="3" Grid.Column="1"
                     Margin="0,5,0,5"/>

            <!-- Drum Quantity -->
            <TextBlock x:Name="DrumQuantityTextBlock" Grid.Row="4" Grid.Column="0"
                       Text="Drum Quantity:"
                       VerticalAlignment="Center"
                       Margin="0,5,8,5"/>
            <TextBox x:Name="DrumQuantityTextBox"
                     Grid.Row="4" Grid.Column="1"
                     Margin="0,5,0,5"/>

            <!-- Drum Net Weight -->
            <TextBlock x:Name="DrumNetWeightTextBlock" Grid.Row="5" Grid.Column="0"
                       Text="Drum Net Weight:"
                       VerticalAlignment="Center"
                       Margin="0,5,8,5"/>
            <TextBox x:Name="DrumNetWeightTextBox"
                     Grid.Row="5" Grid.Column="1"
                     Margin="0,5,0,5"/>

            <!-- Load Method -->
            <TextBlock x:Name="LoadMethodTextBlock" Grid.Row="6" Grid.Column="0"
                       Text="Load Method:"
                       VerticalAlignment="Center"
                       Margin="0,5,8,5"/>
            <ComboBox x:Name="LoadMethodComboBox"
                      Grid.Row="6" Grid.Column="1"
                      Margin="0,5,0,5">
                <ComboBoxItem Content="Sock"/>
                <ComboBoxItem Content="Dense"/>
                <ComboBoxItem Content="Static Dense"/>
                <ComboBoxItem Content="Bucket"/>
                <ComboBoxItem Content="N/A"/>
            </ComboBox>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Add" Margin="0,0,0,0" Click="AddLayerConfirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
